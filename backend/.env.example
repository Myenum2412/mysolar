# Copy to .env and adjust for your environment.
DATABASE_URL=postgresql+psycopg://mysolar:mysolar@127.0.0.1:5432/mysolar
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000

# Google OAuth (same values as frontend/.env.local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated emails that are always administrators.
ADMIN_EMAILS=

# Development only: return the reset link from /api/auth/forgot-password.
EXPOSE_RESET_LINK=true
DEBUG=true
